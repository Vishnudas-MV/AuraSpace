{
  "expo": {
    "name": "Mental Wellness",
    "slug": "mental-wellness-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mentalwellness",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wellness.mentalwellnessapp",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely unlock your mental wellness emotion diary."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F7F6"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.wellness.mentalwellnessapp"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ad5ac615-baa7-4aae-95a1-68cc8868909d"
      }
    },
    "owner": "vishnudasmv"
  }
}
